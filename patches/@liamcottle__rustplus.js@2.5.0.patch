@@ -6,6 +6,17 @@ const protobuf = require("protobufjs");
 const { EventEmitter } = require('events');
 const Camera = require('./camera');
 
+function protocolError(cause) {
+    const error = new Error('Rust+ protocol error');
+    error.code = 'ELRUSTY_PROTOCOL';
+    const missing = /^missing required '([A-Za-z][A-Za-z0-9_]*)'$/.exec(cause?.message || '');
+    const type = cause?.instance?.$type;
+    if (missing && type?.fields?.[missing[1]] && /^\.rustplus\.[A-Za-z0-9_.]+$/.test(type.fullName || '')) {
+        error.field = type.fullName.slice(1) + '.' + missing[1];
+    }
+    return error;
+}
+
 class RustPlus extends EventEmitter {
 
     /**
@@ -75,7 +86,13 @@ class RustPlus extends EventEmitter {
             this.websocket.on('message', (data) => {
 
                 // decode received message
-                var message = this.AppMessage.decode(data);
+                let message;
+                try {
+                    message = this.AppMessage.decode(data);
+                } catch (cause) {
+                    this.emit('error', protocolError(cause));
+                    return;
+                }
 
                 // check if received message is a response and if we have a callback registered for it
                 if(message.response && message.response.seq && this.seqCallbacks[message.response.seq]){
@@ -97,7 +114,7 @@ class RustPlus extends EventEmitter {
                 }
 
                 // fire message event for received messages that aren't handled by callback
-                this.emit('message', this.AppMessage.decode(data));
+                this.emit('message', message);
 
             });
 
@@ -106,6 +123,8 @@ class RustPlus extends EventEmitter {
                 this.emit('disconnected');
             });
 
+        }).catch(() => {
+            this.emit('error', protocolError());
         });
 
     }
